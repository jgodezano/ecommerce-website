# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Merica House of Rocks

# Database (MySQL)
DATABASE_URL=mysql://root:password@localhost:3306/buildmate_db
DB_HOST=localhost
DB_PORT=3306
DB_NAME=buildmate_db
DB_USER=root
DB_PASSWORD=

# JWT / Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production
NEXTAUTH_SECRET=your-nextauth-secret-change-in-production
NEXTAUTH_URL=http://localhost:3000

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# PayPal
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-secret
PAYPAL_ENVIRONMENT=sandbox

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM_ADDRESS=noreply@buildmate.ph
MAIL_FROM_NAME="Merica House of Rocks"

# Google Maps (for delivery map)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key

# Upload
UPLOAD_DIR=public/uploads
MAX_FILE_SIZE=10485760
