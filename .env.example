# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Merica House of Rocks

# Database (SQLite - local file)
# No configuration needed - automatically creates data/merica.db

# JWT / Auth
NEXTAUTH_SECRET=your-nextauth-secret-change-in-production
NEXTAUTH_URL=http://localhost:3000

# Email (SMTP) - Optional for password reset emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM_ADDRESS=noreply@mericahouseofrocks.ph
MAIL_FROM_NAME="Merica House of Rocks"

# Upload
UPLOAD_DIR=public/uploads
MAX_FILE_SIZE=10485760

# To seed the database with demo data, visit: http://localhost:3000/api/seed
# Admin login: admin@mericahouseofrocks.ph / admin123
# Demo customer: demo@mericahouseofrocks.ph / demo123
