# App
NEXT_PUBLIC_APP_URL=https://mericahouseofrocks.ph
NEXT_PUBLIC_APP_NAME=Merica House of Rocks

# Database (MySQL)
DATABASE_URL=mysql://buildmate_user:secure-db-password@production-db-host:3306/buildmate_prod
DB_HOST=production-db-host
DB_PORT=3306
DB_NAME=buildmate_prod
DB_USER=buildmate_user
DB_PASSWORD=secure-db-password

# JWT / Auth
JWT_SECRET= CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
NEXTAUTH_SECRET= CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
NEXTAUTH_URL=https://mericahouseofrocks.ph

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# PayPal
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-production-paypal-client-id
PAYPAL_CLIENT_SECRET=your-production-paypal-secret
PAYPAL_ENVIRONMENT=production

# Email (SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
MAIL_FROM_ADDRESS=noreply@buildmate.ph
MAIL_FROM_NAME="Merica House of Rocks"

# Google Maps (for delivery map)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-production-google-maps-key

# Upload
UPLOAD_DIR=/var/www/uploads
MAX_FILE_SIZE=10485760
